# Research data and secrets never enter version control.
evidence/
data/private/
governance/*.secrets.json
logs/*.payload
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.DS_Store
.pytest_cache/

# Wall-clock runs after 2026-06-30 are not versioned. Only curated historical
# run directories under outputs/runs/ are tracked.
outputs/runs/*/
!outputs/runs/p2_triage/
!outputs/runs/p2_triage/**
!outputs/runs/p2_evaluation/
!outputs/runs/p2_evaluation/**
!outputs/runs/p2_validate/
!outputs/runs/p2_validate/**
